    <main className="page-shell min-h-screen p-5">
      <div className="mx-auto max-w-2xl">
        <Link href="/" className="text-xs font-bold uppercase text-cyan-100">
          ← Feed Briar
        </Link>
        <section className="neon-card corner-cut relative mt-5 p-6">
          <p className="display-y2k text-3xl text-cyan-100">
            <BellRing className="mr-2 inline" />
            NOTIFICAÇÕES
          </p>
          <div className="mt-5 space-y-3">
            {notices.data?.length ? (
              notices.data.map(notice => (
                <article
                  key={notice.id}
                  className="border border-cyan-300/20 bg-black/20 p-4"
                >
                  <p className="text-sm font-bold text-fuchsia-200">
                    {label(notice.type)}
                  </p>
                  <p className="mt-1 text-sm text-slate-100">
                    {notice.isAnonymous === "yes"
                      ? "Anônimo"
                      : notice.sender?.name || "Membro Briar"}
                    {notice.type === "poke"
                      ? " te cutucou."
                      : ` ${notice.body || "interagiu com você."}`}
                  </p>
                  {notice.postId && (
                    <Link
                      href={`/post/${notice.postId}`}
                      className="mt-3 inline-block text-xs font-bold uppercase text-cyan-100"
                    >
                      Abrir publicação
                    </Link>
                  )}
                  {notice.type === "connection" &&
                    notice.sender &&
                    !notice.readAt &&
                    notice.body?.includes("quer") && (
                      <button
                        onClick={() =>
                          accept.mutate({ userId: notice.sender!.id })
                        }
                        className="violet-button ml-3 px-3 py-1 text-xs font-bold uppercase"
                      >
                        Aceitar
                      </button>
                    )}
                  {!notice.readAt && (
                    <button
                      onClick={() =>
                        dismiss.mutate({ notificationId: notice.id })
                      }
                      className="ml-3 mt-3 border border-cyan-300/40 px-3 py-1 text-xs font-bold uppercase text-cyan-100"
                    >
                      Marcar como lida
                    </button>
                  )}
                </article>
              ))
            ) : (
              <p className="text-sm text-slate-300">
                Você não tem interações novas.
              </p>
            )}
          </div>
        </section>
      </div>
    </main>
  );
}
