export function ProfileJukebox({
  target,
  viewer,
}: {
  target: BriarMember;
  viewer: BriarMember | null;
}) {
  const lists = trpc.jukebox.list.useQuery(
    { username: target.username || "briar" },
    { enabled: Boolean(target.username) }
  );
  const utils = trpc.useUtils();
  const [playlistTitle, setPlaylistTitle] = useState("");
  const [track, setTrack] = useState({
    playlistId: 0,
    youtubeUrl: "",
    title: "",
  });
  const create = trpc.jukebox.create.useMutation({
    onSuccess: () => {
      setPlaylistTitle("");
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Playlist criada na sua jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const add = trpc.jukebox.addTrack.useMutation({
    onSuccess: () => {
      setTrack({ playlistId: 0, youtubeUrl: "", title: "" });
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Faixa adicionada à jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const connection = trpc.connections.status.useQuery(
    { username: target.username || "briar" },
    { enabled: Boolean(viewer && target.username && viewer.id !== target.id) }
  );
  const canAdd =
    viewer?.id === target.id || connection.data?.status === "accepted";
  const first = lists.data?.[0];
  return (
    <section className="neon-card corner-cut relative mt-7 p-5">
      <p className="display-y2k text-2xl text-fuchsia-200">JUKEBOX BRIAR</p>
      <p className="mt-1 text-xs text-slate-300">
        Playlists curtas do perfil. Conexões podem adicionar uma faixa por link
        do YouTube.
      </p>
      {viewer?.id === target.id && (
        <form
          onSubmit={event => {
            event.preventDefault();
            if (playlistTitle.trim()) create.mutate({ title: playlistTitle });
          }}
          className="mt-4 flex gap-2"
        >
          <input
            value={playlistTitle}
            onChange={event => setPlaylistTitle(event.target.value)}
            className="y2k-input py-2 text-sm"
            maxLength={60}
            placeholder="Nome da playlist"
          />
          <button className="neon-button px-3 text-xs font-bold">CRIAR</button>
        </form>
      )}
      {lists.data?.map(list => (
        <div
          key={list.id}
          className="mt-4 border border-cyan-300/20 bg-black/20 p-3"
        >
          <p className="text-xs font-extrabold uppercase text-cyan-100">
            {list.title}
          </p>
          {list.tracks.length ? (
            <div className="mt-2 space-y-2">
              {list.tracks.slice(0, 8).map(trackItem => (
                <a
                  key={trackItem.id}
                  href={trackItem.youtubeUrl}
                  target="_blank"
                  rel="noreferrer"
                  className="block border-l-2 border-fuchsia-300 px-2 py-1 text-xs text-slate-100 hover:text-cyan-100"
                >
                  ▶ {trackItem.title}{" "}
                  <span className="text-slate-400">
                    · {trackItem.addedBy.name || "conexão"}
                  </span>
                </a>
              ))}
            </div>
          ) : (
            <p className="mt-2 text-xs text-slate-400">
              A playlist ainda não tem faixas.
            </p>
          )}
        </div>
      ))}
      {canAdd && first && (
        <form
          onSubmit={event => {
            event.preventDefault();
            if (track.youtubeUrl && track.title)
              add.mutate({
                playlistId: track.playlistId || first.id,
                youtubeUrl: track.youtubeUrl,
                title: track.title,
              });
          }}
          className="mt-4 space-y-2 border-t border-cyan-300/20 pt-3"
        >
          <select
            value={track.playlistId || first.id}
            onChange={event =>
              setTrack(previous => ({
                ...previous,
                playlistId: Number(event.target.value),
              }))
            }
            className="y2k-input py-2 text-xs"
          >
            {lists.data?.map(list => (
              <option key={list.id} value={list.id}>
                {list.title}
              </option>
            ))}
          </select>
          <input
            value={track.title}
            onChange={event =>
              setTrack(previous => ({ ...previous, title: event.target.value }))
            }
            className="y2k-input py-2 text-sm"
            maxLength={120}
            placeholder="Título da música"
          />
          <input
            value={track.youtubeUrl}
            onChange={event =>
              setTrack(previous => ({
                ...previous,
                youtubeUrl: event.target.value,
              }))
            }
            className="y2k-input py-2 text-sm"
            type="url"
            placeholder="Link do YouTube"
          />
          <button
            disabled={add.isPending}
            className="violet-button px-3 py-2 text-xs font-bold uppercase"
          >
            Adicionar à jukebox
          </button>
        </form>
      )}
      {viewer && !canAdd && first && (
        <p className="mt-4 text-xs text-fuchsia-200">
          Conecte-se a este perfil para sugerir músicas.
        </p>
      )}
      {!lists.data?.length && viewer?.id !== target.id && (
        <p className="mt-4 text-xs text-slate-400">
          Este perfil ainda não criou uma playlist.
        </p>
      )}
    </section>
  );
}

export function ProfileQuickInteractions({ target }: { target: BriarMember }) {
  const { data: member } = trpc.auth.me.useQuery();
  const [body, setBody] = useState("");
  const [anonymous, setAnonymous] = useState(false);
  const [open, setOpen] = useState(false);
  const utils = trpc.useUtils();
  const ownProfile = member?.id === target.id;
  const connection = trpc.connections.status.useQuery(
    { username: target.username || "briar" },
    { enabled: Boolean(member && target.username && !ownProfile) }
  );
  const refreshConnection = () =>
    utils.connections.status.invalidate({
      username: target.username || "briar",
    });
  const connect = trpc.connections.request.useMutation({
    onSuccess: () => {
      refreshConnection();
      toast.success("Pedido de conexão enviado.");
    },
    onError: error => toast.error(error.message),
  });
  const disconnect = trpc.connections.remove.useMutation({
    onSuccess: () => {
      refreshConnection();
      toast.success("Conexão removida.");
    },
    onError: error => toast.error(error.message),
  });
  const poke = trpc.notifications.poke.useMutation({
    onSuccess: () => toast.success(`Você cutucou @${target.username}!`),
    onError: error => toast.error(error.message),
  });
  const note = trpc.notifications.sendNote.useMutation({
    onSuccess: () => {
      toast.success("Recado entregue na caixa de correio.");
      setBody("");
      setOpen(false);
    },
    onError: error => toast.error(error.message),
  });
  if (!target.username) return null;
  const signin = () => window.location.assign("/?auth=1");
  return (
    <>
      <ProfileJukebox
        target={target}
        viewer={(member || null) as BriarMember | null}
      />
      {!ownProfile && (
        <aside className="fixed bottom-20 right-3 z-30 w-64 md:bottom-6 md:right-6">
          <div className="border border-fuchsia-300/55 bg-[#16012d]/95 p-3 shadow-[0_0_24px_rgba(157,0,255,.38)] backdrop-blur">
            {connection.data?.status === "accepted" ? (
              <button
                onClick={() =>
                  member && disconnect.mutate({ userId: target.id })
                }
                disabled={disconnect.isPending}
                className="mb-2 flex w-full items-center justify-center gap-2 border border-fuchsia-300/55 bg-fuchsia-400/10 py-2 text-xs font-extrabold uppercase text-fuchsia-100"
              >
                {disconnect.isPending ? "Removendo..." : "× Desfazer conexão"}
              </button>
            ) : (
              <button
                onClick={() =>
                  member
                    ? connect.mutate({ username: target.username! })
                    : signin()
                }
                disabled={
                  connect.isPending || connection.data?.status === "pending"
                }
                className="mb-2 flex w-full items-center justify-center gap-2 border border-cyan-300/55 bg-cyan-300/10 py-2 text-xs font-extrabold uppercase text-cyan-100"
              >
                {connection.data?.status === "pending"
                  ? "Pedido enviado"
                  : "+ Conectar"}
              </button>
            )}
            <button
              onClick={() =>
                member ? poke.mutate({ username: target.username! }) : signin()
              }
              disabled={poke.isPending}
              className="neon-button corner-cut flex w-full items-center justify-center gap-2 py-3 text-xs font-extrabold uppercase"
            >
              <Zap size={15} />⚡ Cutucar!
            </button>
            <button
              onClick={() => (member ? setOpen(!open) : signin())}
              className="mt-2 flex w-full items-center justify-center gap-2 border border-cyan-300/45 px-3 py-2 text-xs font-bold uppercase text-cyan-100"
            >
              <Mail size={15} />
              Deixar recado
            </button>
            {open && (
              <form
                onSubmit={event => {
                  event.preventDefault();
                  if (body.trim())
                    note.mutate({
                      username: target.username!,
                      body,
                      isAnonymous: anonymous,
                    });
                }}
                className="mt-3 space-y-2 border-t border-cyan-300/20 pt-3"
              >
                <textarea
                  value={body}
                  onChange={event => setBody(event.target.value)}
                  className="y2k-input min-h-20 text-sm"
                  maxLength={500}
                  placeholder="Aviso, fofoca ou recado..."
                />
                <label className="flex items-center gap-2 text-[11px] text-slate-300">
                  <input
                    type="checkbox"
                    checked={anonymous}
                    onChange={event => setAnonymous(event.target.checked)}
                  />
                  Enviar anonimamente
                </label>
                <button
                  disabled={note.isPending || !body.trim()}
                  className="violet-button flex w-full items-center justify-center gap-2 py-2 text-xs font-extrabold uppercase"
                >
                  <Send size={14} />
                  Enviar
                </button>
              </form>
            )}
          </div>
        </aside>
      )}
    </>
  );
}

export function PersonaComposer({
  member,
  onClose,
}: {
  member: BriarMember;
  onClose: () => void;
}) {
  const [body, setBody] = useState("");
  const [mediaUrl, setMediaUrl] = useState<string | null>(null);
  const [mediaType, setMediaType] = useState<"image" | "video" | null>(null);
  const [uploading, setUploading] = useState(false);
  const [identity, setIdentity] = useState<IdentityMode>("member");
  const [postVisibility, setPostVisibility] = useState<"public" | "connections" | "private">("public");
  const [personaId, setPersonaId] = useState<number | null>(null);
  const [creating, setCreating] = useState(false);
  const [draft, setDraft] = useState({
    name: "",
    username: "",
    avatarUrl: "",
    isPublic: true,
  });
  const utils = trpc.useUtils();
  const personas = trpc.personas.list.useQuery();
  const upload = trpc.media.createUploadUrl.useMutation();
  const create = trpc.social.createPost.useMutation({
    onSuccess: () => {
      utils.social.feedPage.invalidate();
      utils.notifications.unread.invalidate();
      toast.success("Sua atualização entrou no feed.");
      onClose();
    },
    onError: error => toast.error(error.message),
  });
  const addPersona = trpc.personas.create.useMutation({
    onSuccess: result => {
      utils.personas.list.invalidate();
      setPersonaId(result.id);
      setIdentity("persona");
      setCreating(false);
      toast.success("Persona criada e perfil público disponível.");
    },
    onError: error => toast.error(error.message),
  });
  const visibility = trpc.personas.setVisibility.useMutation({
    onSuccess: () => {
      utils.personas.list.invalidate();
      toast.success("Visibilidade da persona atualizada.");
    },
    onError: error => toast.error(error.message),
  });
  const selected = personas.data?.find(persona => persona.id === personaId);
  const media = async (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file) return;
    setUploading(true);
    try {
      const result = await uploadBriarMedia(file, "post", upload.mutateAsync);
      setMediaUrl(result.url);
      setMediaType(file.type.startsWith("video/") ? "video" : "image");
    } catch (error) {
      toast.error(error instanceof Error ? error.message : "Falha no upload.");
    } finally {
      setUploading(false);
      event.target.value = "";
    }
  };
  return (
    <div className="fixed inset-0 z-50 grid place-items-center bg-[#070012]/80 p-4 backdrop-blur-sm">
      <form
        onSubmit={event => {
          event.preventDefault();
          create.mutate({
            body,
            imageUrl: mediaUrl,
            mediaType,
            personaId: identity === "persona" ? personaId : null,
            audienceIdentity: identity,
            visibility: postVisibility,
          });
        }}
        className="neon-card corner-cut relative max-h-[90vh] w-full max-w-xl overflow-y-auto p-6"
      >
        <button
          type="button"
          onClick={onClose}
          className="absolute right-4 top-4 text-slate-300"
        >
          <X size={20} />
        </button>
        <p className="display-y2k text-3xl text-cyan-100">NOVA ATUALIZAÇÃO</p>
        <div className="mt-4 grid grid-cols-3 gap-2">
          {(["member", "persona", "anonymous"] as IdentityMode[]).map(mode => (
            <button
              key={mode}
              type="button"
              onClick={() => setIdentity(mode)}
              className={`border p-2 text-[10px] font-bold uppercase ${identity === mode ? "border-cyan-200 bg-cyan-300/15 text-cyan-100" : "border-white/15 text-slate-300"}`}
            >
              {mode === "member"
                ? "Meu perfil"
                : mode === "persona"
                  ? "Persona"
                  : "Anônimo"}
            </button>
          ))}
        </div>
        <label className="mt-4 block text-xs font-bold uppercase tracking-wider text-cyan-100">
          Quem pode ver esta publicação?
          <select value={postVisibility} onChange={event => setPostVisibility(event.target.value as "public" | "connections" | "private")} className="y2k-input mt-1">
            <option value="public">Público · aparece aberto no feed</option>
            <option value="connections">Só conexões · prévia reservada para o público</option>
            <option value="private">Só eu · prévia reservada para todos</option>
          </select>
        </label>
        {identity === "persona" && (
          <div className="mt-3 border border-fuchsia-300/30 p-3">
            <select
              value={personaId || ""}
              onChange={event =>
                setPersonaId(Number(event.target.value) || null)
              }
              className="y2k-input"
            >
              <option value="">Escolher persona</option>
              {personas.data?.map(persona => (
                <option key={persona.id} value={persona.id}>
                  @{persona.username} · {persona.name}
                  {persona.isPublic ? " · pública" : " · privada"}
                </option>
              ))}
            </select>
            {selected && (
              <div className="mt-3 flex flex-wrap items-center gap-2">
                <Link
                  href={`/persona/${selected.username}`}
                  className="text-xs font-bold uppercase text-cyan-100"
                >
                  Abrir perfil público ↗
                </Link>
                <button
                  type="button"
                  onClick={() =>
                    visibility.mutate({
                      personaId: selected.id,
                      isPublic: !selected.isPublic,
                    })
                  }
                  className="text-xs font-bold uppercase text-fuchsia-200"
                >
                  Tornar {selected.isPublic ? "privada" : "pública"}
                </button>
              </div>
            )}
            <button
              type="button"
              onClick={() => setCreating(!creating)}
              className="mt-3 text-xs font-bold uppercase text-fuchsia-200"
            >
              {creating ? "Cancelar" : "+ Criar persona"}
            </button>
            {creating && (
              <div className="mt-2 grid gap-2">
                <input
                  className="y2k-input"
                  required
                  value={draft.name}
                  onChange={event =>
                    setDraft(previous => ({
                      ...previous,
                      name: event.target.value,
                    }))
                  }
                  placeholder="Nome da persona"
                />
                <input
                  className="y2k-input"
                  required
                  value={draft.username}
                  onChange={event =>
                    setDraft(previous => ({
                      ...previous,
                      username: event.target.value
                        .toLowerCase()
                        .replace(/[^a-z0-9_]/g, ""),
                    }))
                  }
                  placeholder="usuario_persona"
                />
                <input
                  className="y2k-input"
                  type="url"
                  value={draft.avatarUrl}
                  onChange={event =>
                    setDraft(previous => ({
                      ...previous,
                      avatarUrl: event.target.value,
                    }))
                  }
                  placeholder="URL da foto (opcional)"
                />
                <label className="flex items-center gap-2 text-xs text-slate-300">
                  <input
                    type="checkbox"
                    checked={draft.isPublic}
                    onChange={event =>
                      setDraft(previous => ({
                        ...previous,
                        isPublic: event.target.checked,
                      }))
                    }
                  />
                  Criar perfil público compartilhável
                </label>
                <button
                  type="button"
                  disabled={
                    addPersona.isPending || !draft.name || !draft.username
                  }
                  onClick={() =>
                    addPersona.mutate({
                      ...draft,
                      avatarUrl: draft.avatarUrl || null,
                    })
                  }
                  className="violet-button py-2 text-xs font-bold uppercase"
                >
                  <CirclePlus size={14} />
                  Criar persona
                </button>
              </div>
            )}
          </div>
        )}
        <div className="mt-4 flex items-center gap-3">
          <MemberAvatar
            member={
              selected
                ? {
                    ...member,
                    name: selected.name,
                    avatarUrl: selected.avatarUrl,
                  }
                : member
            }
            className="h-10 w-10 border border-fuchsia-400"
          />
          <div>
            <p className="font-bold text-cyan-100">
              {identity === "anonymous"
                ? "Anônimo"
                : selected?.name || member.name}
            </p>
            <p className="text-xs text-slate-400">
              {identity === "anonymous"
                ? "Sua identidade real é protegida"
                : `@${selected?.username || member.username}`}
            </p>
          </div>
        </div>
        <textarea
          autoFocus
          maxLength={2000}
          className="y2k-input mt-5 min-h-32"
          value={body}
          onChange={event => setBody(event.target.value)}
          placeholder="O que está rolando no campus?"
        />
        {mediaUrl && (
          <div className="relative mt-3">
            {mediaType === "video" ? (
              <video src={mediaUrl} controls className="max-h-56 w-full" />
            ) : (
              <img
                src={mediaUrl}
                alt="Prévia"
                className="max-h-56 w-full object-cover"
              />
            )}
            <button
              type="button"
              onClick={() => {
                setMediaUrl(null);
                setMediaType(null);
              }}
              className="absolute right-2 top-2 border border-cyan-200 bg-[#0d0221]/80 p-1 text-cyan-100"
            >
              <X size={16} />
            </button>
          </div>
        )}
        <div className="mt-4 flex items-center justify-between gap-3">
          <label className="flex items-center gap-2 text-xs font-bold uppercase text-fuchsia-200">
            <ImagePlus size={18} />
            {uploading ? "Enviando" : "Anexar mídia"}
            <input
              type="file"
              accept="image/png,image/jpeg,image/webp,image/gif,video/mp4,video/webm"
              className="hidden"
              onChange={media}
            />
          </label>
          <button
            disabled={
              create.isPending ||
              uploading ||
              (!body.trim() && !mediaUrl) ||
              (identity === "persona" && !personaId)
            }
            className="neon-button corner-cut flex items-center gap-2 px-4 py-2 text-xs font-extrabold uppercase disabled:opacity-50"
          >
            {identity === "anonymous" ? (
              <EyeOff size={15} />
            ) : (
              <Send size={15} />
            )}
            Publicar
          </button>
        </div>
      </form>
    </div>
  );
}

