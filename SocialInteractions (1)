import { useEffect, useState, type ChangeEvent } from "react";
import React from "react";
import { Link } from "wouter";

type PlaylistTheme = "briar" | "midnight" | "holographic" | "ice" | "custom";
type PlaylistStyleDraft = { playlistId: number; title: string; thumbnailUrl: string | null; theme: PlaylistTheme; accentColor: string; surfaceColor: string };

function ManagedProfileJukebox({
  target,
  viewer,
}: {
  target: BriarMember;
  viewer: BriarMember | null;
}) {
  const lists = trpc.jukebox.list.useQuery(
    { username: target.username || "briar" },
    { enabled: Boolean(target.username) }
  );
  const utils = trpc.useUtils();
  const [playlistTitle, setPlaylistTitle] = useState("");
  const [track, setTrack] = useState({
    playlistId: 0,
    youtubeUrl: "",
    title: "",
  });
  const [active, setActive] = useState<{
    title: string;
    youtubeUrl: string;
  } | null>(null);
  const [editing, setEditing] = useState<{
    id: number;
    title: string;
    youtubeUrl: string;
  } | null>(null);
  const [customizing, setCustomizing] = useState<PlaylistStyleDraft | null>(null);
  const thumbnailUpload = trpc.media.createUploadUrl.useMutation();
  const create = trpc.jukebox.create.useMutation({
    onSuccess: () => {
      setPlaylistTitle("");
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Playlist criada na sua jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const add = trpc.jukebox.addTrack.useMutation({
    onSuccess: () => {
      setTrack({ playlistId: 0, youtubeUrl: "", title: "" });
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Faixa adicionada à jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const updateTrack = trpc.jukebox.updateTrack.useMutation({
    onSuccess: () => {
      setEditing(null);
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Faixa atualizada.");
    },
    onError: error => toast.error(error.message),
  });
  const removeTrack = trpc.jukebox.removeTrack.useMutation({
    onSuccess: () => {
      setActive(null);
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Faixa removida da jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const updatePlaylist = trpc.jukebox.update.useMutation({
    onSuccess: () => {
      setCustomizing(null);
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Visual da playlist atualizado.");
    },
    onError: error => toast.error(error.message),
  });
  const removePlaylist = trpc.jukebox.remove.useMutation({
    onSuccess: () => {
      setCustomizing(null);
      setActive(null);
      utils.jukebox.list.invalidate({ username: target.username || "briar" });
      toast.success("Playlist removida da jukebox.");
    },
    onError: error => toast.error(error.message),
  });
  const connection = trpc.connections.status.useQuery(
    { username: target.username || "briar" },
    { enabled: Boolean(viewer && target.username && viewer.id !== target.id) }
  );
  const canAdd =
    viewer?.id === target.id || connection.data?.status === "accepted";
  const first = lists.data?.[0];
  const embed = active?.youtubeUrl.match(
    /(?:youtu\.be\/|youtube\.com\/(?:watch\?v=|embed\/|shorts\/))([\w-]{11})/
  )?.[1];
  const themeStyle = (list: { theme: PlaylistTheme; accentColor: string; surfaceColor: string; thumbnailUrl: string | null }) => {
    const presets: Record<Exclude<PlaylistTheme, "custom">, { accent: string; surface: string }> = { briar: { accent: "#00f0ff", surface: "#190038" }, midnight: { accent: "#9d00ff", surface: "#090014" }, holographic: { accent: "#ff5fd2", surface: "#162358" }, ice: { accent: "#9bf7ff", surface: "#06324b" } };
    const palette = list.theme === "custom" ? { accent: list.accentColor, surface: list.surfaceColor } : presets[list.theme];
    return { borderColor: palette.accent, backgroundColor: palette.surface, backgroundImage: list.thumbnailUrl ? `linear-gradient(90deg, ${palette.surface}ed, ${palette.surface}b8), url(${list.thumbnailUrl})` : undefined, backgroundSize: "cover", backgroundPosition: "center", boxShadow: `0 0 18px ${palette.accent}33` };
  };
  const chooseTheme = (theme: PlaylistTheme) => setCustomizing(current => {
    if (!current) return current;
    const presets: Record<Exclude<PlaylistTheme, "custom">, { accentColor: string; surfaceColor: string }> = { briar: { accentColor: "#00f0ff", surfaceColor: "#190038" }, midnight: { accentColor: "#9d00ff", surfaceColor: "#090014" }, holographic: { accentColor: "#ff5fd2", surfaceColor: "#162358" }, ice: { accentColor: "#9bf7ff", surfaceColor: "#06324b" } };
    return theme === "custom" ? { ...current, theme } : { ...current, theme, ...presets[theme] };
  });
  const sendThumbnail = async (event: ChangeEvent<HTMLInputElement>) => {
    const file = event.target.files?.[0];
    if (!file || !customizing) return;
    try {
      const uploaded = await uploadBriarMedia(file, "jukebox-thumbnail", thumbnailUpload.mutateAsync);
      setCustomizing(current => current ? { ...current, thumbnailUrl: uploaded.url } : current);
      toast.success("Miniatura pronta para salvar.");
    } catch (error) { toast.error(error instanceof Error ? error.message : "Não foi possível enviar a miniatura."); }
    finally { event.target.value = ""; }
  };
  return (
    <section className="neon-card corner-cut relative mt-7 p-5">
      <p className="display-y2k text-2xl text-fuchsia-200">JUKEBOX BRIAR</p>
      <p className="mt-1 text-xs text-slate-300">
        Playlists curtas do perfil. Conexões podem adicionar uma faixa por link
        do YouTube.
      </p>
      {active && (
        <div className="relative mt-4 overflow-hidden border border-cyan-200/60 bg-black shadow-[0_0_20px_rgba(0,240,255,.2)]">
          <div className="flex items-center justify-between gap-3 border-b border-cyan-200/20 px-3 py-2">
            <p className="truncate text-xs font-bold uppercase text-cyan-100">
              ▶ {active.title}
            </p>
            <button
              type="button"
              onClick={() => setActive(null)}
              className="text-xs font-bold text-fuchsia-200"
            >
              FECHAR
            </button>
          </div>
          {embed ? (
            <iframe
              className="aspect-video w-full"
              src={`https://www.youtube-nocookie.com/embed/${embed}?autoplay=1`}
              title={`Player: ${active.title}`}
              allow="autoplay; encrypted-media; picture-in-picture"
              allowFullScreen
            />
          ) : (
            <p className="p-4 text-xs text-fuchsia-200">
              Este link não pôde ser reproduzido aqui.
            </p>
          )}
        </div>
      )}
      {viewer?.id === target.id && (
        <form
          onSubmit={event => {
            event.preventDefault();
            if (playlistTitle.trim()) create.mutate({ title: playlistTitle });
          }}
          className="mt-4 flex gap-2"
        >
          <input
            value={playlistTitle}
            onChange={event => setPlaylistTitle(event.target.value)}
            className="y2k-input py-2 text-sm"
            maxLength={60}
            placeholder="Nome da playlist"
          />
          <button className="neon-button px-3 text-xs font-bold">CRIAR</button>
        </form>
      )}
      {lists.data?.map(list => (
        <div
          key={list.id}
          className="mt-4 border bg-black/20 p-3"
          style={themeStyle(list)}
        >
          <div className="flex items-center justify-between gap-3"><div className="flex min-w-0 items-center gap-2">{list.thumbnailUrl ? <img src={list.thumbnailUrl} alt="" className="h-9 w-9 rounded border border-white/30 object-cover" /> : <span className="grid h-9 w-9 place-items-center rounded border border-white/25 bg-black/20 text-sm">♫</span>}<p className="truncate text-xs font-extrabold uppercase text-cyan-100">{list.title}</p></div>{viewer?.id === target.id && <span className="flex shrink-0 gap-2 text-[10px] font-bold uppercase"><button type="button" onClick={() => setCustomizing({ playlistId: list.id, title: list.title, thumbnailUrl: list.thumbnailUrl, theme: list.theme as PlaylistTheme, accentColor: list.accentColor, surfaceColor: list.surfaceColor })} className="text-fuchsia-100">Personalizar</button><button type="button" disabled={removePlaylist.isPending} onClick={() => { if (window.confirm(`Remover a playlist "${list.title}" e todas as suas faixas? Essa ação não pode ser desfeita.`)) removePlaylist.mutate({ playlistId: list.id }); }} className="text-red-300 disabled:opacity-50">Remover</button></span>}</div>
          {customizing?.playlistId === list.id && <div className="mt-3 grid gap-2 border-t border-white/20 pt-3"><label className="text-[10px] font-bold uppercase text-cyan-100">Título<input value={customizing.title} onChange={event => setCustomizing(current => current ? { ...current, title: event.target.value } : current)} className="y2k-input mt-1 py-2 text-xs" maxLength={60} /></label><label className="text-[10px] font-bold uppercase text-cyan-100">Tema<select value={customizing.theme} onChange={event => chooseTheme(event.target.value as PlaylistTheme)} className="y2k-input mt-1 py-2 text-xs"><option value="briar">Briar neon</option><option value="midnight">Midnight</option><option value="holographic">Holográfico</option><option value="ice">Gelo</option><option value="custom">Cores livres</option></select></label><div className="grid grid-cols-2 gap-2"><label className="text-[10px] font-bold uppercase text-cyan-100">Destaque<input type="color" value={customizing.accentColor} onChange={event => setCustomizing(current => current ? { ...current, accentColor: event.target.value, theme: "custom" } : current)} className="mt-1 h-9 w-full" /></label><label className="text-[10px] font-bold uppercase text-cyan-100">Fundo<input type="color" value={customizing.surfaceColor} onChange={event => setCustomizing(current => current ? { ...current, surfaceColor: event.target.value, theme: "custom" } : current)} className="mt-1 h-9 w-full" /></label></div><label className="cursor-pointer border border-dashed border-cyan-200/50 px-3 py-2 text-[10px] font-bold uppercase text-cyan-100">{thumbnailUpload.isPending ? "Enviando miniatura..." : "Enviar miniatura de imagem"}<input type="file" accept="image/png,image/jpeg,image/webp,image/gif" className="hidden" disabled={thumbnailUpload.isPending} onChange={sendThumbnail} /></label>{customizing.thumbnailUrl && <div className="flex items-center justify-between gap-2"><img src={customizing.thumbnailUrl} alt="Prévia da miniatura" className="h-12 w-12 border border-cyan-200 object-cover" /><button type="button" onClick={() => setCustomizing(current => current ? { ...current, thumbnailUrl: null } : current)} className="text-[10px] font-bold uppercase text-fuchsia-100">Remover miniatura</button></div>}<div className="flex gap-3"><button type="button" onClick={() => updatePlaylist.mutate(customizing)} disabled={updatePlaylist.isPending || !customizing.title.trim()} className="neon-button px-3 py-2 text-[10px] font-bold uppercase">Salvar visual</button><button type="button" onClick={() => setCustomizing(null)} className="text-[10px] font-bold uppercase text-slate-300">Cancelar</button></div></div>}
          {list.tracks.length ? (
            <div className="mt-2 space-y-2">
              {list.tracks.slice(0, 8).map(trackItem => {
                const canManage =
                  viewer?.id === target.id ||
                  viewer?.id === trackItem.addedById;
                const isEditing = editing?.id === trackItem.id;
                return (
                  <div
                    key={trackItem.id}
                    className="border-l-2 border-fuchsia-300 px-2 py-2"
                  >
                    {isEditing ? (
                      <div className="grid gap-2">
                        <input
                          value={editing.title}
                          onChange={event =>
                            setEditing({
                              ...editing,
                              title: event.target.value,
                            })
                          }
                          className="y2k-input py-1 text-xs"
                          maxLength={120}
                          aria-label="Editar título da faixa"
                        />
                        <input
                          value={editing.youtubeUrl}
                          onChange={event =>
                            setEditing({
                              ...editing,
                              youtubeUrl: event.target.value,
                            })
                          }
                          className="y2k-input py-1 text-xs"
                          aria-label="Editar link da faixa"
                        />
                        <div className="flex gap-3 text-[10px] font-bold uppercase">
                          <button
                            type="button"
                            onClick={() => updateTrack.mutate(editing)}
                            className="text-cyan-100"
                          >
                            Salvar
                          </button>
                          <button
                            type="button"
                            onClick={() => setEditing(null)}
                            className="text-slate-300"
                          >
                            Cancelar
                          </button>
                        </div>
                      </div>
                    ) : (
                      <div className="flex items-center justify-between gap-2">
                        <button
                          type="button"
                          onClick={() =>
                            setActive({
                              title: trackItem.title,
                              youtubeUrl: trackItem.youtubeUrl,
                            })
                          }
                          className="min-w-0 flex-1 truncate text-left text-xs text-slate-100 hover:text-cyan-100"
                        >
                          ▶ {trackItem.title}{" "}
                          <span className="text-slate-400">
                            · {trackItem.addedBy.name || "conexão"}
                          </span>
                        </button>
                        {canManage && (
                          <span className="flex shrink-0 gap-2 text-[10px] font-bold uppercase">
                            <button
                              type="button"
                              onClick={() =>
                                setEditing({
                                  id: trackItem.id,
                                  title: trackItem.title,
                                  youtubeUrl: trackItem.youtubeUrl,
                                })
                              }
                              className="text-cyan-100"
                            >
                              Editar
                            </button>
                            <button
                              type="button"
                              onClick={() =>
                                removeTrack.mutate({ trackId: trackItem.id })
                              }
                              className="text-fuchsia-200"
                            >
                              Remover
                            </button>
                          </span>
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          ) : (
            <p className="mt-2 text-xs text-slate-400">
              A playlist ainda não tem faixas.
            </p>
          )}
        </div>
      ))}
      {canAdd && first && (
        <form
          onSubmit={event => {
            event.preventDefault();
            if (track.youtubeUrl && track.title)
              add.mutate({
                playlistId: track.playlistId || first.id,
                youtubeUrl: track.youtubeUrl,
                title: track.title,
              });
          }}
          className="mt-4 space-y-2 border-t border-cyan-300/20 pt-3"
        >
          <select
            value={track.playlistId || first.id}
            onChange={event =>
              setTrack(previous => ({
                ...previous,
                playlistId: Number(event.target.value),
              }))
            }
            className="y2k-input py-2 text-xs"
          >
            {lists.data?.map(list => (
              <option key={list.id} value={list.id}>
                {list.title}
              </option>
            ))}
          </select>
          <input
            value={track.title}
            onChange={event =>
              setTrack(previous => ({ ...previous, title: event.target.value }))
            }
            className="y2k-input py-2 text-sm"
            maxLength={120}
            placeholder="Título da música"
          />
          <input
            value={track.youtubeUrl}
            onChange={event =>
              setTrack(previous => ({
                ...previous,
                youtubeUrl: event.target.value,
              }))
            }
            className="y2k-input py-2 text-sm"
            type="url"
            placeholder="Link do YouTube"
          />
          <button
            disabled={add.isPending}
            className="violet-button px-3 py-2 text-xs font-bold uppercase"
          >
            Adicionar à jukebox
          </button>
        </form>
      )}
      {viewer && !canAdd && first && (
        <p className="mt-4 text-xs text-fuchsia-200">
          Conecte-se a este perfil para sugerir músicas.
        </p>
      )}
      {!lists.data?.length && viewer?.id !== target.id && (
        <p className="mt-4 text-xs text-slate-400">
          Este perfil ainda não criou uma playlist.
        </p>
      )}
    </section>
  );
}
