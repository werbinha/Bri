export function NotificationOverlay() {
  const { data: member } = trpc.auth.me.useQuery();
  const utils = trpc.useUtils();
  const notices = trpc.notifications.unread.useQuery(undefined, {
    enabled: Boolean(member),
    refetchInterval: member ? 10_000 : false,
    refetchIntervalInBackground: false,
  });
  const dismiss = trpc.notifications.dismiss.useMutation({
    onSuccess: () => {
      utils.notifications.unread.invalidate();
      utils.notifications.list.invalidate();
    },
  });
  const pokeBack = trpc.notifications.poke.useMutation({
    onSuccess: () => {
      toast.success("Cutucada retribuída!");
      utils.notifications.unread.invalidate();
    },
  });
  const notice = notices.data?.[0];
  if (!member || !notice) return null;
  const sender =
    notice.isAnonymous === "yes"
      ? "ANÔNIMO"
      : notice.sender?.name || "ALGUÉM DO CAMPUS";
  const close = () => dismiss.mutate({ notificationId: notice.id });
  if (notice.levelUpLevel !== null) return <LevelUpCelebration level={notice.levelUpLevel} onClose={close} />;
  const isLevelUp = false;
  return (
    <div className="pointer-events-none fixed inset-0 z-[70] grid place-items-center bg-[#070012]/25 p-4">
      <section className={`${isLevelUp ? "level-up-pop" : "msn-shake"} pointer-events-auto relative w-full max-w-md overflow-hidden border-2 border-cyan-200 bg-[#17002f] p-1 shadow-[0_0_34px_rgba(0,240,255,.65)]`}>
        <div className="flex items-center justify-between bg-gradient-to-r from-cyan-300 via-fuchsia-500 to-violet-700 px-3 py-2 text-xs font-extrabold uppercase text-[#10021f]">
          <span>{isLevelUp ? "Briar Level Up // 2000" : "Briar Messenger 2000"}</span>
          <button onClick={close} aria-label="Fechar aviso">
            <X size={16} />
          </button>
        </div>
        <div className="p-5">
          <p className="display-y2k text-2xl text-cyan-100">
            {isLevelUp
              ? "✦ NÍVEL ALCANÇADO!"
              : notice.type === "poke"
              ? "⚡ VOCÊ FOI CUTUCADA!"
              : "✉ NOVO RECADO"}
          </p>
          {!isLevelUp && <p className="mt-3 text-sm font-bold text-fuchsia-200">{sender}</p>}
          {isLevelUp && <p className="mt-3 display-y2k text-6xl leading-none text-fuchsia-200 text-glow">Lv. {notice.levelUpLevel}</p>}
          <p className="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-100">
            {isLevelUp
              ? "Seu brilho no campus aumentou. Continue publicando e recebendo cutucadas para alcançar o próximo marco!"
              : notice.type === "poke"
              ? `@${notice.sender?.username || "membro"} cutucou você. Que tal retribuir?`
              : notice.body}
          </p>
          <div className="mt-5 flex justify-end gap-2">
            {!isLevelUp && notice.type === "poke" && notice.sender?.username && (
              <button
                onClick={() => {
                  pokeBack.mutate({ username: notice.sender!.username! });
                  close();
                }}
                className="violet-button px-3 py-2 text-xs font-extrabold uppercase"
              >
                <Zap size={14} />
                Cutucar de volta
              </button>
            )}
            <button
              onClick={close}
              className="neon-button corner-cut px-5 py-2 text-xs font-extrabold uppercase"
            >
              OK
            </button>
          </div>
        </div>
      </section>
    </div>
  );
}

export function GalleryMediaViewer() {
  const [active, setActive] = useState<{
    src: string;
    kind: "image" | "video";
    alt: string;
    href: string;
  } | null>(null);
  const [minimized, setMinimized] = useState(false);
  useEffect(() => {
    const open = (event: MouseEvent) => {
      const target = event.target as HTMLElement | null;
      const link = target?.closest('a[href^="/post/"]');
      const media = link?.querySelector("img,video") as
        | HTMLImageElement
        | HTMLVideoElement
        | null;
      const href = link?.getAttribute("href");
      if (!link || !media || !href || !link.closest('[role="tabpanel"]'))
        return;
      event.preventDefault();
      setMinimized(false);
      setActive({
        src: media.currentSrc || media.src,
        kind: media.tagName === "VIDEO" ? "video" : "image",
        alt: media.getAttribute("alt") || "Mídia do perfil",
        href,
      });
    };
    document.addEventListener("click", open, true);
    return () => document.removeEventListener("click", open, true);
  }, []);
  if (!active) return null;
  if (minimized)
    return (
      <div className="fixed bottom-5 right-5 z-[85] flex overflow-hidden border border-cyan-200 bg-[#190038] text-xs font-extrabold uppercase shadow-[0_0_24px_rgba(0,240,255,.5)]">
        <button
          type="button"
          onClick={() => setMinimized(false)}
          className="px-4 py-3 text-cyan-100"
        >
          ▣ Imagem minimizada
        </button>
        <Link
          href={active.href}
          onClick={() => setActive(null)}
          className="border-l border-cyan-300/30 px-4 py-3 text-fuchsia-100"
        >
          Abrir post
        </Link>
      </div>
    );
  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-label="Visualizador de mídia"
      className="fixed inset-0 z-[85] grid place-items-center bg-[#070012]/90 p-4 backdrop-blur-sm"
      onClick={() => setActive(null)}
    >
      <section
        className="neon-card corner-cut relative w-full max-w-5xl overflow-hidden p-2"
        onClick={event => event.stopPropagation()}
      >
        <div className="absolute right-4 top-4 z-10 flex gap-2">
          <Link
            href={active.href}
            onClick={() => setActive(null)}
            className="border border-fuchsia-300 bg-[#120225]/90 px-3 py-1 text-xs font-extrabold text-fuchsia-100"
          >
            ABRIR POSTAGEM
          </Link>
          <button
            type="button"
            onClick={() => setMinimized(true)}
            className="border border-fuchsia-300 bg-[#120225]/90 px-3 py-1 text-xs font-extrabold text-fuchsia-100"
          >
            MINIMIZAR
          </button>
          <button
            type="button"
            onClick={() => setActive(null)}
            className="border border-cyan-200 bg-[#120225]/90 px-3 py-1 text-xs font-extrabold text-cyan-100"
          >
            FECHAR
          </button>
        </div>
        {active.kind === "video" ? (
          <video
            src={active.src}
            controls
            autoPlay
            className="max-h-[78vh] w-full bg-black object-contain"
          />
        ) : (
          <img
            src={active.src}
            alt={active.alt}
            className="max-h-[78vh] w-full object-contain"
          />
        )}
      </section>
    </div>
  );
}

export function CommunityCard() {
  const community = trpc.social.community.useQuery();
  if (community.isLoading || !community.data)
    return (
      <aside className="neon-card corner-cut relative p-5">
        <p className="display-y2k text-xl text-cyan-100">CONECTADOS</p>
